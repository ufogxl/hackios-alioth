<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.wifi</string>
	<!-- with wifi=1 among the kernel's arguments: join the network fw/network names (src/net_test.m,
	     "autojoin": first line the name, second the passphrase, joined through the Apple80211 request
	     Settings makes, the driver's own scan finding the access point), have configd configure the
	     interface by DHCP, wait for an address, then use the link -- a name resolved, an HTTP answer
	     fetched. What the job says goes to /private/var/net_test.log as well, and "report" says it
	     again at the end: the console's log is a ring and a long session pushes its own start out. -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/net_test</string>
		<string>wait</string>
		<string>10</string>
		<string>autojoin</string>
		<string>dhcp</string>
		<string>en0</string>
		<string>waitaddr</string>
		<string>en0</string>
		<string>30</string>
		<string>show</string>
		<string>resolve</string>
		<string>captive.apple.com</string>
		<string>fetch</string>
		<string>http://captive.apple.com/hotspot-detect.html</string>
		<string>wait</string>
		<string>60</string>
		<string>report</string>
		<string>/private/var/net_test.log</string>
		<string>scan</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
